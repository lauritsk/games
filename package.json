{
  "name": "games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec tsx watch src/server/index.ts",
    "install:ci": "vp install --frozen-lockfile",
    "build": "vp build",
    "build:production": "vp run build && vp run build:server",
    "build:server": "vp build --ssr src/server/index.ts --outDir dist-server",
    "lint": "vp lint",
    "fix": "vp fmt && vp lint --fix",
    "typecheck": "vp exec tsc --noEmit",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "vp exec playwright install chromium && vp exec playwright test",
    "docs:api": "vp exec tsx src/server/api-docs.ts",
    "audit": "pnpm audit",
    "check": "vp run lint && vp run test && vp run build && vp run build:server && vp run test:e2e"
  },
  "dependencies": {
    "valibot": "1.4.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "fast-check": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite-plus": "0.1.21"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@11.1.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
