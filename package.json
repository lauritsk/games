{
  "name": "games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp exec tsx watch src/server/index.ts",
    "install:ci": "vp install --frozen-lockfile",
    "db:migrate": "vp exec tsx src/server/migrate.ts",
    "db:generate": "vp exec drizzle-kit generate",
    "build": "vp build",
    "build:analyze": "vp build --mode analyze",
    "build:production": "vp run build && vp run build:server",
    "build:server": "vp build --ssr src/server/index.ts --outDir dist-server",
    "build:single": "vp build --outDir dist-single",
    "lint": "hk check --all",
    "fix": "hk fix --all",
    "typecheck": "vp exec tsc --noEmit",
    "test": "vp test run",
    "test:changed": "vp test run --changed",
    "test:coverage": "vp test run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reportsDirectory=coverage",
    "test:e2e": "vp exec playwright install chromium && vp exec playwright test",
    "test:watch": "vp test watch",
    "docs:api": "vp exec tsx src/server/api-docs.ts",
    "audit": "pnpm audit",
    "check": "vp run lint && vp run test && vp run build && vp run build:server && vp run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2",
    "valibot": "1.4.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite-plus": "0.1.21"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
