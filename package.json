{
  "name": "games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vp build",
    "build:analyze": "vp build --mode analyze",
    "build:production": "pnpm run build && pnpm run build:server",
    "build:server": "vp build --ssr src/server/index.ts --outDir dist-server",
    "build:single": "vp build --outDir dist-single",
    "typecheck": "tsc --noEmit",
    "test": "vp test run test/*.test.ts",
    "test:changed": "vp test run --changed",
    "test:coverage": "vp test run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reportsDirectory=coverage test/*.test.ts",
    "test:e2e": "playwright install chromium && playwright test",
    "test:watch": "vp test watch test/*.test.ts",
    "docs:api": "tsx src/server/api-docs.ts",
    "audit": "pnpm audit",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "12.10.0",
    "drizzle-orm": "0.45.2",
    "valibot": "1.4.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.8.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.10",
    "fast-check": "4.7.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "packageManager": "pnpm@11.1.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
